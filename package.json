{
  "name": "pixsift-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "deploy":"opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cloudinary:check": "bun run scripts/cloudinary-check.ts",
    "seed": "bun run scripts/seed-cloudinary.ts",
    "db:seed": "node --env-file=.env --import tsx scripts/seed-mongo.mts",
    "db:check": "node --env-file=.env --import tsx scripts/db-check.mts",
    "db:analyze": "node --env-file=.env --conditions react-server --import tsx scripts/analyze-pins.mts",
    "db:evaluate": "node --env-file=.env --conditions react-server --import tsx scripts/evaluate-algorithms.mts",
    "db:benchmark": "node --env-file=.env --conditions react-server --import tsx scripts/benchmark-algorithms.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.26.0",
    "mongodb": "^7.5.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
